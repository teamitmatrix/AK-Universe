# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in auth e-mails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail notifications (resend.com → API Keys; verify the sending domain first)
RESEND_API_KEY=
# Sender, on the verified domain, e.g. AK Universe <contact@ak-universe.fr>
EMAIL_FROM=
# Who receives "new project" notifications (comma-separated)
EMAIL_NOTIFY_TO=

# Extra sign-in buttons, once enabled in Supabase → Auth → Providers: "apple", "azure" (Microsoft), or "apple,azure"
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Only for `npm run setup:supabase` (not needed on Vercel)
# supabase.com → Account (top right) → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra exact redirect URLs, comma-separated, e.g. https://ak-universe.vercel.app/**
SUPABASE_EXTRA_REDIRECTS=

# Signs the two-factor cookies (any long random string, e.g. `openssl rand -base64 32`).
# Optional: derived from SUPABASE_SERVICE_ROLE_KEY when empty.
AUTH_SECRET=

# Site chatbot (platform.openai.com → API keys). Knowledge is edited on /admin.html?vue=chatbot.
OPENAI_API_KEY=
# Optional, default gpt-4.1-mini
OPENAI_MODEL=
